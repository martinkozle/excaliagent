{
  "name": "excaliagent",
  "version": "0.3.0",
  "description": "A 2D Excalidraw board for your coding agents: every session is a card you place",
  "type": "module",
  "license": "MIT",
  "author": "Martin Popovski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinkozle/excaliagent.git"
  },
  "homepage": "https://github.com/martinkozle/excaliagent#readme",
  "bugs": {
    "url": "https://github.com/martinkozle/excaliagent/issues"
  },
  "bin": {
    "excaliagent": "bin/excaliagent.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "node src/server/cli.ts --dev --no-open",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:web && playwright test",
    "demo": "node scripts/demo.ts",
    "prepare": "npm run build",
    "screenshots": "node scripts/screenshots.ts"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "opencode",
    "excalidraw",
    "herdr",
    "agents",
    "sessions",
    "board"
  ],
  "overrides": {
    "lodash-es": "^4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "^5.1.16"
      }
    }
  }
}
